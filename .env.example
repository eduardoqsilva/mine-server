# copie para .env e ajuste  ->  cp .env.example .env && chmod 600 .env

# --- Bot de Telegram (obrigatorio) ---
# token do @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCDEF

# Codigo de resgate: e a SENHA do bot. Quem mandar "/start <este codigo>" vira
# admin e rebaixa o admin anterior. Mude para o que quiser, mas guarde: sem ele
# ninguem recupera o acesso se voce perder sua conta. Formato livre (o bot
# compara o texto, com espaco ou sem), minimo de 8 caracteres, e nunca aparece
# em log. Sugestao: RV-9f3a-2b71-4c08
TELEGRAM_ADMIN_CLAIM_CODE=trocarsenha

# --- Servidor ---
# Primeira instalacao so. Depois quem manda no servidor e o bot: /config no
# Telegram, que grava em data/server.properties. Nao ponha aqui gamemode,
# difficulty, max-players, view-distance, allow-list, server-name nem ops:
# o image reescreve o server.properties em todo boot e sobrescreveria o que
# voce mudou pelo bot. Se voce mudar algo aqui, mude tambem pelo /config.
# nome da pasta do mundo em data/worlds/; so o primeiro boot usa este valor
LEVEL_NAME=world
TZ=America/Sao_Paulo

# uid/gid do dono de ./data (no seu caso ubuntu = 1000). Rode chown antes do 1o boot.
PUID=1000
PGID=1000

# versao do BDS. LATEST = estavel mais recente, conferida a cada start.
VERSION=LATEST

# IP publico que o nethernet anuncia ao jogador. VAZIO (o normal) e o certo:
# o bds roda em network_mode: host, enxerga as interfaces da maquina e escolhe
# o candidato ICE sozinho. Preencha so se a rede host nao bastar - NAT do
# provedor sem porta fixa, ou maquina com mais de um IP. Preenchido, quem
# estiver na mesma LAN deixa de entrar.
SERVER_IP=

# --- Bot: agenda e comportamento ---
# reinicio automatico diario (reaplica a versao estavel mais nova)
UPDATE_HOUR=5
UPDATE_MINUTE=0
# segundos de aviso no console antes de reiniciar
ANNOUNCE_SECONDS=20
# quantos dias o bot espera o servidor responder o ping depois do restart
BOOT_TIMEOUT=240
# versoes antigas de pack guardadas em ./data/.addon-backups
BACKUP_KEEP=3

# --- Backup do mundo ---
# O /backup (ou o automatico semanal) derruba o servidor por ~1min, avisa o
# jogo antes e volta sozinho. O que entra no .tar.gz: o mundo, os packs
# instalados, a config (server.properties, allowlist, permissions) e o bot.db.
# Nao entra o binario do BDS (245 MB que o image rebaixa sozinho).
BACKUPS_DIR=/state/backups
# quantos ficam na VPS. Rotacao por contagem: a cada backup novo o mais
# velho sai, entao o disco nao cresce.
BACKUP_LOCAL_KEEP=5
# quantos ficam no Dropbox. O seu espaco la e pequeno, entao 3.
BACKUP_DROPBOX_KEEP=3
# dia da semana e hora do backup automatico. 0=segunda ... 6=domingo.
# Sabado as 04:00 fica uma hora antes do auto-update das 05:00, para os dois
# reinicios nao cairem no mesmo dia colados.
BACKUP_DAY=5
BACKUP_HOUR=4
BACKUP_MINUTE=0

# --- Dropbox (onde o backup fica, com link para baixar) ---
# Sem isso o /backup ainda funciona, mas so deixa o arquivo na VPS e te diz o
# caminho para copiar por SSH.
#
# Monte uma app em https://www.dropbox.com/developers/apps (Scoped Access,
# App Folder). Em Permissions, ligue estas cinco, e sao cinco porque o bot faz
# mais que subir arquivo: ele lista a pasta para girar os antigos, apaga o
# mais velho e cria o link de download. Faltando qualquer uma delas o upload
# funciona e a rotacao quebra com insufficient_permissions.
#   files.content.write    sobe o .tar.gz
#   files.metadata.read    lista a pasta /backups
#   files.metadata.write   apaga o backup mais antigo
#   sharing.write          cria o link do backup novo
#   sharing.read           procura um link que ja existe
# Nao precisa de files.content.read: o bot nunca baixa nada do Dropbox.
# Em OAuth, pegue o App key e o App secret.
#
# Para pegar o refresh token. NAO procure no App Console: o botao "Generate"
# da secao OAuth 2 so devolve um access token, e ele expira em ~4h. O refresh
# token nao aparece em nenhum lugar do console, ele so existe depois que o
# codigo de autorizacao e trocado por tokens. Sao dois passos:
#
# 1. Abra no navegador, trocando APP_KEY pelo seu, aceite o acesso e copie o
#    codigo que o Dropbox mostrar na propria pagina (ele mostra porque o
#    redirect_uri e opcional nesse fluxo):
#
# https://www.dropbox.com/oauth2/authorize?client_id=APP_KEY&response_type=code&token_access_type=offline
#
# 2. Troque o codigo pelo refresh token. Este script faz a troca e, com
#    --salvar, ja escreve as 3 linhas aqui em baixo, que e o jeito mais seguro:
#    colar na mao e onde esse processo costuma falhar, com o token velho
#    sobrando no arquivo sem ninguem perceber.
#
# python tools/dropbox_token.py APP_KEY APP_SECRET CODE --salvar
#
# O token_access_type=offline da URL acima e obrigatorio: sem ele o Dropbox
# devolve so o access token e o script reclama que faltou o refresh_token.
#
# >>> ORDEM QUE IMPORTA: marque as 5 permissoes acima na aba Permissions e
# >>> salve ANTES de abrir a URL e trocar o codigo. Quem decide a lista de
# >>> escopos do token e a configuracao da app, nao o momento da troca: um
# >>> token emitido antes de voce marcar as caixas sai sem nenhum escopo, e
# >>> refazer a troca depois nao conserta. Se o bot reclamar de insufficient
# >>> permissions, rode tools/dropbox_check.py: ele pergunta ao Dropbox quais
# >>> escopos o token carrega e diz se o problema e a app ou o token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Atalho so para testar na hora, e o access token dura ~4h: depois disso o
# backup falha. Use o refresh token acima.
DROPBOX_TOKEN=

# --- Bot: avancado (so mexer se precisar) ---
# onde fica o bot.db (usuarios, hashes das chaves, config salva, auditoria).
# Montado como ./state no compose; se mudar, ajuste o volume tambem.
STATE_DIR=/state
# host que o bot pinga para saber se o jogo esta no ar. Padrao: mine-bedrock
# (o container do jogo, pela rede do compose). So mude se voce apontar para
# outro host.
#BDS_HOST=mine-bedrock
#BDS_PORT=19132
# teto de upload, limitado pelo Telegram a 20971520 (20 MB)
#MAX_UPLOAD_BYTES=20971520
