# copie para .env e ajuste  ->  cp .env.example .env && chmod 600 .env

# --- Bot de Telegram (obrigatorio) ---
# token do @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCDEF

# Codigo de resgate: e a SENHA do bot. Quem mandar "/start <este codigo>" vira
# admin e rebaixa o admin anterior. Mude para o que quiser, mas guarde: sem ele
# ninguem recupera o acesso se voce perder sua conta. Formato livre (o bot
# compara o texto, com espaco ou sem), minimo de 8 caracteres, e nunca aparece
# em log. Sugestao: RV-9f3a-2b71-4c08
TELEGRAM_ADMIN_CLAIM_CODE=trocarsenha

# --- Servidor ---
# Primeira instalacao so. Depois quem manda no servidor e o bot: /config no
# Telegram, que grava em data/server.properties. Nao ponha aqui gamemode,
# difficulty, max-players, view-distance, allow-list, server-name nem ops:
# o image reescreve o server.properties em todo boot e sobrescreveria o que
# voce mudou pelo bot. Se voce mudar algo aqui, mude tambem pelo /config.
# nome da pasta do mundo em data/worlds/; so o primeiro boot usa este valor
LEVEL_NAME=world
TZ=America/Sao_Paulo

# uid/gid do dono de ./data (no seu caso ubuntu = 1000). Rode chown antes do 1o boot.
PUID=1000
PGID=1000

# versao do BDS. LATEST = estavel mais recente, conferida a cada start.
VERSION=LATEST

# --- Bot: agenda e comportamento ---
# reinicio automatico diario (reaplica a versao estavel mais nova)
UPDATE_HOUR=5
UPDATE_MINUTE=0
# segundos de aviso no console antes de reiniciar
ANNOUNCE_SECONDS=20
# quantos dias o bot espera o servidor responder o ping depois do restart
BOOT_TIMEOUT=240
# versoes antigas de pack guardadas em ./data/.addon-backups
BACKUP_KEEP=3

# --- Bot: avancado (so mexer se precisar) ---
# onde fica o bot.db (usuarios, hashes das chaves, config salva, auditoria).
# Montado como ./state no compose; se mudar, ajuste o volume tambem.
STATE_DIR=/state
# host que o bot pinga para saber se o jogo esta no ar. Padrao: mine-bedrock
# (o container do jogo, pela rede do compose). So mude se voce apontar para
# outro host.
#BDS_HOST=mine-bedrock
#BDS_PORT=19132
# teto de upload, limitado pelo Telegram a 20971520 (20 MB)
#MAX_UPLOAD_BYTES=20971520
